{
  "_comment": "Elastic Query DSL: Credential Stuffing Multi-Account Sliding Window Aggregation",
  "_framework": "Elasticsearch 8.x / Elastic Security",
  "_technique": "MITRE ATT&CK T1110.004",
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-5m"
            }
          }
        },
        {
          "bool": {
            "should": [
              {
                "term": {
                  "event.code": "4625"
                }
              },
              {
                "bool": {
                  "must": [
                    {
                      "term": {
                        "event.category": "authentication"
                      }
                    },
                    {
                      "term": {
                        "event.outcome": "failure"
                      }
                    }
                  ]
                }
              }
            ],
            "minimum_should_match": 1
          }
        }
      ]
    }
  },
  "aggs": {
    "suspicious_source_ips": {
      "terms": {
        "field": "source.ip",
        "size": 50,
        "min_doc_count": 5
      },
      "aggs": {
        "distinct_usernames_attempted": {
          "cardinality": {
            "field": "user.name"
          }
        },
        "credential_stuffing_filter": {
          "bucket_selector": {
            "buckets_path": {
              "distinctUserCount": "distinct_usernames_attempted"
            },
            "script": "params.distinctUserCount >= 5"
          }
        }
      }
    }
  }
}
